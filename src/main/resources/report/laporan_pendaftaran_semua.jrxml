<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pendaftaran_semua" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
<queryString language="SQL"><![CDATA[SELECT p.id_pendaftaran,p.tanggal_daftar,p.status AS status_pendaftaran,ps.nim,ps.nama AS nama_peserta,kls.nama_kelas,krs.kode_kursus,krs.nama_kursus,ins.nama AS nama_instruktur FROM pendaftaran p JOIN peserta ps ON p.id_peserta=ps.id_peserta JOIN kelas kls ON p.id_kelas=kls.id_kelas JOIN kursus krs ON kls.id_kursus=krs.id_kursus JOIN instruktur ins ON kls.id_instruktur=ins.id_instruktur ORDER BY p.id_pendaftaran]]></queryString>
<field name="id_pendaftaran" class="java.lang.Integer"/><field name="tanggal_daftar" class="java.sql.Date"/><field name="status_pendaftaran" class="java.lang.String"/><field name="nim" class="java.lang.String"/><field name="nama_peserta" class="java.lang.String"/><field name="nama_kelas" class="java.lang.String"/><field name="kode_kursus" class="java.lang.String"/><field name="nama_kursus" class="java.lang.String"/><field name="nama_instruktur" class="java.lang.String"/>
<title><band height="48"><staticText><reportElement x="0" y="6" width="802" height="28"/><textElement textAlignment="Center"><font size="17" isBold="true"/></textElement><text><![CDATA[LAPORAN PENDAFTARAN KURSUS]]></text></staticText></band></title>
<columnHeader><band height="24"><staticText><reportElement x="0" y="0" width="45" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement x="45" y="0" width="80" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[NIM]]></text></staticText><staticText><reportElement x="125" y="0" width="135" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Peserta]]></text></staticText><staticText><reportElement x="260" y="0" width="110" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Kelas]]></text></staticText><staticText><reportElement x="370" y="0" width="170" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Kursus]]></text></staticText><staticText><reportElement x="540" y="0" width="120" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Instruktur]]></text></staticText><staticText><reportElement x="660" y="0" width="80" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Tanggal]]></text></staticText><staticText><reportElement x="740" y="0" width="62" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText></band></columnHeader>
<detail><band height="22"><textField><reportElement x="0" y="0" width="45" height="20"/><textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression></textField><textField><reportElement x="45" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression></textField><textField><reportElement x="125" y="0" width="135" height="20"/><textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression></textField><textField><reportElement x="260" y="0" width="110" height="20"/><textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression></textField><textField><reportElement x="370" y="0" width="170" height="20"/><textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression></textField><textField><reportElement x="540" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{nama_instruktur}]]></textFieldExpression></textField><textField><reportElement x="660" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{tanggal_daftar}]]></textFieldExpression></textField><textField><reportElement x="740" y="0" width="62" height="20"/><textFieldExpression><![CDATA[$F{status_pendaftaran}]]></textFieldExpression></textField></band></detail>
