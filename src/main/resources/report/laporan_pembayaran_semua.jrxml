<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pembayaran_semua" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
<queryString language="SQL"><![CDATA[SELECT pb.id_pembayaran,pb.tanggal_bayar,pb.nominal,pb.metode,pb.status AS status_pembayaran,p.id_pendaftaran,ps.nim,ps.nama AS nama_peserta,kls.nama_kelas,krs.nama_kursus FROM pembayaran pb JOIN pendaftaran p ON pb.id_pendaftaran=p.id_pendaftaran JOIN peserta ps ON p.id_peserta=ps.id_peserta JOIN kelas kls ON p.id_kelas=kls.id_kelas JOIN kursus krs ON kls.id_kursus=krs.id_kursus ORDER BY pb.tanggal_bayar,pb.id_pembayaran]]></queryString>
<field name="id_pembayaran" class="java.lang.Integer"/><field name="tanggal_bayar" class="java.sql.Date"/><field name="nominal" class="java.math.BigDecimal"/><field name="metode" class="java.lang.String"/><field name="status_pembayaran" class="java.lang.String"/><field name="id_pendaftaran" class="java.lang.Integer"/><field name="nim" class="java.lang.String"/><field name="nama_peserta" class="java.lang.String"/><field name="nama_kelas" class="java.lang.String"/><field name="nama_kursus" class="java.lang.String"/>
<title><band height="48"><staticText><reportElement x="0" y="6" width="802" height="28"/><textElement textAlignment="Center"><font size="17" isBold="true"/></textElement><text><![CDATA[LAPORAN PEMBAYARAN KURSUS]]></text></staticText></band></title>
<columnHeader><band height="24"><staticText><reportElement x="0" y="0" width="45" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement x="45" y="0" width="55" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Daftar]]></text></staticText><staticText><reportElement x="100" y="0" width="80" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[NIM]]></text></staticText><staticText><reportElement x="180" y="0" width="140" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Peserta]]></text></staticText><staticText><reportElement x="320" y="0" width="120" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Kelas]]></text></staticText><staticText><reportElement x="440" y="0" width="90" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Tanggal]]></text></staticText><staticText><reportElement x="530" y="0" width="100" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Nominal]]></text></staticText><staticText><reportElement x="630" y="0" width="85" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Metode]]></text></staticText><staticText><reportElement x="715" y="0" width="87" height="22"/><textElement><font isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText></band></columnHeader>
<detail><band height="22"><textField><reportElement x="0" y="0" width="45" height="20"/><textFieldExpression><![CDATA[$F{id_pembayaran}]]></textFieldExpression></textField><textField><reportElement x="45" y="0" width="55" height="20"/><textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression></textField><textField><reportElement x="100" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression></textField><textField><reportElement x="180" y="0" width="140" height="20"/><textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression></textField><textField><reportElement x="320" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression></textField><textField><reportElement x="440" y="0" width="90" height="20"/><textFieldExpression><![CDATA[$F{tanggal_bayar}]]></textFieldExpression></textField><textField pattern="Rp #,##0"><reportElement x="530" y="0" width="100" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{nominal}]]></textFieldExpression></textField><textField><reportElement x="630" y="0" width="85" height="20"/><textFieldExpression><![CDATA[$F{metode}]]></textFieldExpression></textField><textField><reportElement x="715" y="0" width="87" height="20"/><textFieldExpression><![CDATA[$F{status_pembayaran}]]></textFieldExpression></textField></band></detail>
